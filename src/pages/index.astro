---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Projects from "../components/Projects.astro";
import Stack from "../components/Stack.astro";
import HeroScene from "../components/islands/HeroScene";
import Base from "../layouts/Base.astro";
---

<Base>
  <Nav />
  <div class="hero-side-scene pointer-events-none fixed top-1/2 z-0 hidden -translate-y-1/2 overflow-hidden" aria-hidden="true">
    <HeroScene client:idle />
  </div>
  <main id="content" class="relative z-10">
    <Hero />
    <Projects />
    <Experience />
    <Stack />
    <About />
    <Contact />
  </main>
</Base>
