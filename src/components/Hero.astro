---
import { profile, executiveHighlights, getAssetUrl, getPageUrl } from "../data/site";

const corePillTags = [
  "Multi-Agent AI (LangGraph & FastMCP)",
  "Voice AI (Deepgram & ElevenLabs)",
  "Python & FastAPI Microservices",
  "AWS & Kubernetes Cloud",
  "MEAN Stack & TypeScript",
  "Scalable SDET & BDD Frameworks",
];
---

<section id="top" class="relative overflow-hidden pt-24 pb-16 md:pt-32 md:pb-24">
  <!-- Subtle ambient central light glow -->
  <div class="pointer-events-none absolute top-12 left-1/2 -z-10 h-96 w-full -translate-x-1/2 max-w-5xl opacity-25 blur-3xl">
    <div class="h-full w-full bg-gradient-to-r from-emerald-500/30 via-teal-500/25 to-cyan-500/20"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Hero Grid Layout -->
    <div class="grid items-stretch gap-6 lg:grid-cols-[1.25fr_0.75fr]">
      <!-- Cell 1: Main Overview & Recruiter Action Hub -->
      <div data-reveal class="bento-card flex flex-col justify-between p-6 sm:p-10">
        <div>
          <!-- Live Status Beacon Pill -->
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-medium text-emerald-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span>{profile.availabilityStatus}</span>
            <span class="text-emerald-500/60">·</span>
            <span class="text-slate-300 font-mono-tech">{profile.location}</span>
          </div>

          <!-- Name & Title with Gradient Shimmer -->
          <h1 class="font-display mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
            <span class="text-gradient-framer">{profile.name}</span>
          </h1>

          <div class="mt-2.5 flex flex-wrap items-center gap-2 text-base sm:text-lg font-medium">
            <span class="text-sky-400 font-semibold">{profile.role}</span>
            <span class="hidden sm:inline text-slate-600">•</span>
            <span class="text-slate-300 font-normal">{profile.secondaryRole}</span>
          </div>

          <!-- Value Proposition -->
          <p class="mt-5 text-base sm:text-lg leading-relaxed text-slate-300 max-w-2xl font-normal">
            {profile.headline}
          </p>

          <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-400 max-w-2xl">
            {profile.summary}
          </p>

          <!-- Core Competency Chips -->
          <div class="mt-6 flex flex-wrap gap-2" aria-label="Core Competencies">
            {
              corePillTags.map((tag) => (
                <span class="inline-flex items-center rounded-lg border border-white/[0.08] bg-white/[0.03] px-2.5 py-1 text-xs font-mono-tech text-slate-300 hover:border-sky-400/40 hover:text-sky-200 transition-colors">
                  <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-sky-400"></span>
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Recruiter Action Bar -->
        <div class="mt-8 flex flex-wrap items-center gap-3 pt-6 border-t border-white/[0.08]">
          <a
            href={getPageUrl("resume")}
            class="inline-flex items-center gap-2 rounded-xl bg-sky-500 px-5 py-3 text-xs sm:text-sm font-semibold text-slate-950 transition-all hover:bg-sky-400 hover:shadow-lg hover:shadow-sky-500/25 active:scale-95"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download / View Resume</span>
          </a>

          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.05] px-4 py-3 text-xs sm:text-sm font-semibold text-white transition-all hover:border-sky-400/40 hover:bg-sky-500/10 hover:text-sky-300"
          >
            <span>Explore Case Studies</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Quick 1-click Copy Email -->
          <button
            type="button"
            onclick={`window.copyToClipboard('${profile.email}', 'Copied email: ${profile.email}')`}
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/80 px-3.5 py-3 text-xs sm:text-sm font-medium text-slate-300 transition-all hover:border-white/20 hover:text-white"
            title="Click to copy email"
          >
            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span class="hidden sm:inline">Copy Email</span>
          </button>

          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/80 p-3 text-xs sm:text-sm font-medium text-slate-300 transition-all hover:border-sky-400/40 hover:text-sky-300"
            aria-label="LinkedIn Profile"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Cell 2: Candidate Profile Card (Professional Identity & Executive Focus) -->
      <div data-reveal data-reveal-delay="150" class="bento-card flex flex-col justify-between p-6 sm:p-7">
        <!-- Hexagonal Tech Avatar (Aurora Borealis) -->
        <div class="relative flex justify-center px-2 pt-2">
          <!-- Outer aura glow -->
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_42%,rgba(16,185,129,0.18),transparent_65%)] blur-2xl"></div>

          <div class="relative aspect-square w-full max-w-[260px]">
            <!-- Emerald → teal → cyan hex ring -->
            <div class="hex-clip absolute inset-0 bg-gradient-to-br from-emerald-400 via-teal-400 to-cyan-400"></div>
            <!-- Portrait, hex-cropped -->
            <div class="hex-clip absolute inset-[3px] overflow-hidden">
              <img
                src={getAssetUrl("portrait.jpg")}
                alt="Portrait of Rohith Reddy — Technical Architect"
                width="961"
                height="1024"
                class="h-full w-full object-cover object-[center_18%] filter saturate-[1.05] transition-transform duration-500 hover:scale-[1.04]"
                loading="eager"
              />
            </div>
          </div>
        </div>

        <!-- Identity Pill -->
        <div class="mt-4 flex items-center justify-between rounded-lg border border-emerald-400/25 bg-slate-900/90 p-2.5 backdrop-blur-md">
          <div>
            <p class="font-display text-xs font-bold text-white">Rohith Reddy</p>
            <p class="font-mono-tech text-[10px] text-sky-400">Technical Architect · Solugenix</p>
          </div>
          <span class="rounded bg-emerald-500/20 px-2 py-0.5 text-[10px] font-mono-tech text-emerald-300 border border-emerald-400/30">
            Hyderabad, IN
          </span>
        </div>

        <!-- Executive Candidate Details (No project misplacement) -->
        <div class="mt-4 rounded-xl border border-white/[0.08] bg-slate-950/70 p-4 space-y-2.5 text-xs">
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-2">
            <span class="text-slate-400 font-mono-tech">Current Role</span>
            <span class="font-semibold text-white">Technical Architect @ Solugenix</span>
          </div>

          <div class="flex items-center justify-between border-b border-white/[0.06] pb-2">
            <span class="text-slate-400 font-mono-tech">Team Leadership</span>
            <span class="font-semibold text-sky-300">Squads of 10–20 Engineers</span>
          </div>

          <div class="flex items-center justify-between border-b border-white/[0.06] pb-2">
            <span class="text-slate-400 font-mono-tech">Primary Focus</span>
            <span class="font-semibold text-white">Generative AI & Agentic Systems</span>
          </div>

          <div class="flex items-center justify-between pt-0.5 text-[11px] font-mono-tech text-slate-400">
            <span>Enterprise SDET & CI/CD</span>
            <span class="text-emerald-400">10+ YOE Track Record</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Executive Metric Cards (Bottom 4-column row) -->
    <div data-reveal data-reveal-delay="200" class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        executiveHighlights.map((stat) => (
          <div class="bento-card p-5 sm:p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono-tech text-xs font-semibold text-slate-400 uppercase tracking-wider">
                {stat.label}
              </span>
              <div class="font-display mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-white" data-count={stat.value}>
                {stat.value}
              </div>
            </div>
            <p class="mt-2 text-xs font-mono-tech text-sky-400/90">
              {stat.sublabel}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
