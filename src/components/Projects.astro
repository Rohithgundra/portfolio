---
import { projects } from "../data/site";

const categories = [
  { id: "all", label: "All Case Studies (6)" },
  { id: "agentic-ai", label: "Agentic AI & Voice" },
  { id: "document-ai", label: "Document Intelligence" },
  { id: "quality-ai", label: "AI Quality Engineering" },
  { id: "enterprise", label: "Enterprise Scale" },
];
---

<section id="projects" class="relative border-t border-white/[0.08] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Header -->
    <div data-reveal class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3 py-1 text-xs font-mono-tech text-sky-300">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
          Projects & Case Studies
        </div>
        <h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          <span class="text-gradient-framer">Enterprise AI platforms,</span> multi-agent systems & quality engineering.
        </h2>
        <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed">
          Production systems designed to bridge non-deterministic LLM capabilities with deterministic enterprise workflows.
        </p>
      </div>

      <!-- Category Filter Pills (Framer Style) -->
      <div class="flex flex-wrap gap-1.5 rounded-2xl border border-white/[0.08] bg-slate-900/60 p-1.5 backdrop-blur-md" role="tablist">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat.id}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              class={`project-filter-btn rounded-xl px-3 py-1.5 text-xs font-medium transition-all ${
                idx === 0
                  ? "bg-sky-500 text-slate-950 font-semibold shadow-md shadow-sky-500/25"
                  : "text-slate-300 hover:text-white hover:bg-white/[0.05]"
              }`}
            >
              {cat.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Bento Projects Grid -->
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="projects-grid">
      {
        projects.map((project, idx) => {
          // Genix Nova gets its own full-width showcase row.
          const isFullWidth = project.id === "genix-nova";

          return (
            <article
              data-project-item
              data-category={project.category}
              data-reveal
              class={`bento-card group flex flex-col justify-between p-6 sm:p-8 ${
                isFullWidth ? "md:col-span-2 lg:col-span-3" : ""
              }`}
            >
              <div>
                <!-- Top Meta Row -->
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div class="flex items-center gap-2">
                    <span class="rounded-full border border-sky-400/30 bg-sky-500/10 px-2.5 py-0.5 text-[11px] font-mono-tech text-sky-300">
                      {project.categoryLabel}
                    </span>
                    <span class="text-xs font-mono-tech text-slate-400">
                      {project.org} · {project.domain}
                    </span>
                  </div>

                  {project.metrics && (
                    <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-mono-tech text-emerald-300">
                      {project.metrics}
                    </span>
                  )}
                </div>

                <!-- Title & Headline -->
                <div class="mt-4">
                  <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-white group-hover:text-sky-300 transition-colors">
                    {project.name}
                  </h3>
                  <p class="font-mono-tech mt-1 text-xs sm:text-sm text-sky-400">
                    {project.tagline}
                  </p>
                </div>

                {isFullWidth ? (
                  <>
                    <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-300">
                      {project.brief}
                    </p>

                    <!-- Role & Focus -->
                    <div class="mt-4 grid gap-2 text-xs sm:grid-cols-2 sm:gap-x-8 sm:text-sm">
                      <div class="flex items-start gap-2">
                        <span class="font-mono-tech w-11 shrink-0 text-sky-400">Role</span>
                        <span class="min-w-0 text-slate-300">{project.role}</span>
                      </div>
                      <div class="flex items-start gap-2">
                        <span class="font-mono-tech w-11 shrink-0 text-sky-400">Focus</span>
                        <span class="min-w-0 text-slate-300">{project.focus}</span>
                      </div>
                    </div>

                    <!-- Architecture Pipeline & Flow: single row, four columns -->
                    {project.workflowSteps && project.workflowSteps.length > 0 && (
                      <div class="mt-6 rounded-xl border border-white/[0.06] bg-slate-950/70 p-4">
                        <p class="font-mono-tech text-[10px] font-bold tracking-wider text-slate-400 uppercase">
                          Architecture Pipeline & Flow
                        </p>
                        <div class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
                          {project.workflowSteps.map((step) => (
                            <div class="rounded-lg border border-white/[0.05] bg-white/[0.02] p-2.5">
                              <span class="font-mono-tech text-[10px] font-bold text-sky-400">
                                {step.step}
                              </span>
                              <h4 class="font-display mt-0.5 text-xs font-semibold text-white">
                                {step.title}
                              </h4>
                              <p class="mt-1 text-[11px] leading-relaxed text-slate-400">
                                {step.desc}
                              </p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    <!-- Architecture Details (full list on full-width card) -->
                    <div class="mt-6 border-t border-white/[0.08] pt-5">
                      <h4 class="font-mono-tech text-xs font-semibold tracking-wider text-slate-400 uppercase">
                        Architectural Specifications
                      </h4>
                      <ul class="mt-3 grid gap-x-6 gap-y-2.5 md:grid-cols-2 text-xs sm:text-sm text-slate-300">
                        {project.architecture.map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="mt-1 text-sky-400 shrink-0">
                              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                              </svg>
                            </span>
                            <span class="leading-relaxed">{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                ) : (
                  <>
                    <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-300">
                      {project.brief}
                    </p>

                    <!-- Workflow Pipeline Bento Inset (for Featured Projects) -->
                    {project.workflowSteps && project.workflowSteps.length > 0 && (
                      <div class="mt-6 rounded-xl border border-white/[0.06] bg-slate-950/70 p-4">
                        <p class="font-mono-tech text-[10px] font-bold tracking-wider text-slate-400 uppercase">
                          Architecture Pipeline & Flow
                        </p>
                        <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
                          {project.workflowSteps.map((step) => (
                            <div class="rounded-lg border border-white/[0.05] bg-white/[0.02] p-2.5">
                              <span class="font-mono-tech text-[10px] font-bold text-sky-400">
                                {step.step}
                              </span>
                              <h4 class="font-display mt-0.5 text-xs font-semibold text-white">
                                {step.title}
                              </h4>
                              <p class="mt-1 text-[11px] leading-relaxed text-slate-400">
                                {step.desc}
                              </p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    <!-- Architecture Details -->
                    <div class="mt-6 border-t border-white/[0.08] pt-5">
                      <h4 class="font-mono-tech text-xs font-semibold tracking-wider text-slate-400 uppercase">
                        Architectural Specifications
                      </h4>
                      <ul class="mt-3 space-y-2 text-xs sm:text-sm text-slate-300">
                        {project.architecture.slice(0, 3).map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="mt-1 text-sky-400 shrink-0">
                              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                              </svg>
                            </span>
                            <span class="leading-relaxed">{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                )}
              </div>

              <!-- Bottom Footer: Tech Pills & Impact -->
              <div class="mt-6 pt-5 border-t border-white/[0.08]">
                <div class="flex flex-wrap gap-1.5" aria-label="Technologies">
                  {project.tags.map((tag) => (
                    <span class="rounded bg-sky-500/10 px-2 py-0.5 text-[11px] font-mono-tech text-sky-300 border border-sky-500/20">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-4 rounded-lg bg-sky-500/5 border border-sky-500/20 px-3.5 py-2.5 text-xs text-slate-300">
                  <strong class="font-semibold text-sky-300">Enterprise Value: </strong>
                  {project.delivers}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Interactive category filter handler
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".project-filter-btn");
  const projectCards = document.querySelectorAll<HTMLElement>("[data-project-item]");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetCategory = btn.dataset.filter;

      filterBtns.forEach((b) => {
        b.classList.remove("bg-sky-500", "text-slate-950", "font-semibold", "shadow-md", "shadow-sky-500/25");
        b.classList.add("text-slate-300");
        b.setAttribute("aria-selected", "false");
      });

      btn.classList.remove("text-slate-300");
      btn.classList.add("bg-sky-500", "text-slate-950", "font-semibold", "shadow-md", "shadow-sky-500/25");
      btn.setAttribute("aria-selected", "true");

      projectCards.forEach((card) => {
        const cardCat = card.dataset.category;
        if (targetCategory === "all" || cardCat === targetCategory) {
          card.style.display = "flex";
          card.classList.add("is-visible");
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
