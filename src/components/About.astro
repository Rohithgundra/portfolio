---
import { corePrinciples, architecturalPractices, certifications, education, recruiterSnapshot } from "../data/site";
---

<section id="about" class="relative border-t border-white/[0.08] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Header -->
    <div data-reveal class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3 py-1 text-xs font-mono-tech text-sky-300">
        <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
        Philosophy & Credentials
      </div>
      <h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
        <span class="text-gradient-framer">Bridging non-deterministic AI</span> with deterministic enterprise quality.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed">
        A model is never a product until it is governed inside an observable, reliable workflow that stakeholders can trust.
      </p>
    </div>

    <!-- 2-Column Bento Grid: Narrative & Recruiter Fast-Scan Deck -->
    <div class="mt-12 grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
      <!-- Left Column: Narrative & Principles -->
      <div data-reveal class="space-y-6 text-slate-300 leading-relaxed text-sm sm:text-base">
        <div class="bento-card p-6 sm:p-8 space-y-4">
          <p>
            I am a <strong class="text-white font-semibold">Technical Architect and Lead SDET with 10+ years of hands-on experience</strong> spanning enterprise application architecture, quality engineering, and AI-powered platforms. Currently at <strong class="text-sky-300 font-semibold">Solugenix India Pvt Ltd</strong>, I architect production multi-agent systems, intelligent document processing pipelines, and AI-assisted quality copilots from discovery through CI/CD.
          </p>
          <p class="text-slate-400 text-xs sm:text-sm">
            Throughout my career across firms like <strong class="text-slate-200">Deloitte, MatchMove, Aurigo Software, and Electronic Arts</strong>, I have witnessed how fragile software becomes when delivery rushes past robust verification. When Generative AI emerged, I recognized that LLMs amplify this challenge: probabilistic models require even stricter validation boundaries, deterministic schema checking, and Human-in-the-Loop governance.
          </p>
          <p class="text-slate-400 text-xs sm:text-sm">
            I lead engineering squads (10 to 20 engineers), defining roadmaps for where AI belongs—and just as importantly, where deterministic code remains the right tool for the job.
          </p>
        </div>

        <!-- 3 Core Principles Bento Cards -->
        <div class="grid gap-4 sm:grid-cols-3">
          {
            corePrinciples.map((principle) => (
              <div class="bento-card p-5 flex flex-col justify-between">
                <div>
                  <div class="h-2 w-2 rounded-full bg-sky-400 mb-3"></div>
                  <h4 class="font-display text-sm font-bold text-white">
                    {principle.title}
                  </h4>
                  <p class="mt-2 text-xs leading-relaxed text-slate-400">
                    {principle.text}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Recruiter Command Deck & Certifications -->
      <div data-reveal data-reveal-delay="150" class="flex flex-col gap-6">
        <!-- Recruiter Quick View Bento Card -->
        <div class="bento-card p-6 sm:p-7">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-base font-bold text-white">
              Recruiter Quick View
            </h3>
            <span class="inline-flex items-center rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-300 border border-emerald-500/30">
              Active Candidate
            </span>
          </div>

          <dl class="mt-5 space-y-3 text-xs">
            <div class="flex justify-between border-b border-white/[0.06] pb-2">
              <dt class="text-slate-400">Total Experience</dt>
              <dd class="font-semibold text-white">{recruiterSnapshot.yearsExperience}</dd>
            </div>
            <div class="flex justify-between border-b border-white/[0.06] pb-2">
              <dt class="text-slate-400">Current Role</dt>
              <dd class="font-semibold text-sky-300 text-right">Technical Architect</dd>
            </div>
            <div class="flex justify-between border-b border-white/[0.06] pb-2">
              <dt class="text-slate-400">Team Leadership</dt>
              <dd class="font-semibold text-white text-right">Squads of 10–20 Engineers</dd>
            </div>
            <div class="flex justify-between border-b border-white/[0.06] pb-2">
              <dt class="text-slate-400">Location Base</dt>
              <dd class="font-semibold text-white text-right">Hyderabad, Telangana</dd>
            </div>
            <div>
              <dt class="text-slate-400 mb-1.5">Target Positions</dt>
              <dd class="flex flex-wrap gap-1">
                {recruiterSnapshot.targetRoles.map((role) => (
                  <span class="rounded bg-white/[0.05] px-2 py-0.5 text-[10px] font-mono-tech text-slate-300 border border-white/[0.08]">
                    {role}
                  </span>
                ))}
              </dd>
            </div>
          </dl>

          <div class="mt-6 pt-4 border-t border-white/[0.08] flex gap-2">
            <a
              href="/resume"
              class="flex-1 text-center rounded-xl bg-sky-500 py-2.5 text-xs font-semibold text-slate-950 transition-all hover:bg-sky-400 shadow-md shadow-sky-500/20"
            >
              Full Resume (PDF)
            </a>
            <a
              href="#contact"
              class="flex-1 text-center rounded-xl border border-white/10 bg-white/[0.04] py-2.5 text-xs font-semibold text-white transition-all hover:bg-white/[0.08]"
            >
              Connect
            </a>
          </div>
        </div>

        <!-- Certifications & Education Bento Card -->
        <div class="bento-card p-6 sm:p-7">
          <h3 class="font-display text-sm font-bold text-white uppercase tracking-wider">
            Certifications & Education
          </h3>

          <div class="mt-4 space-y-3">
            {
              certifications.map((cert) => (
                <div class="rounded-xl border border-white/[0.06] bg-slate-950/60 p-3">
                  <div class="flex items-center justify-between">
                    <h4 class="font-display text-xs font-semibold text-white">
                      {cert.title}
                    </h4>
                    <span class="rounded bg-sky-500/20 px-1.5 py-0.5 text-[9px] font-mono-tech text-sky-300 border border-sky-400/30">
                      {cert.badge}
                    </span>
                  </div>
                  <p class="mt-1 text-[11px] text-slate-400">
                    {cert.issuer} ({cert.year})
                  </p>
                </div>
              ))
            }
          </div>

          <div class="mt-3 rounded-xl border border-white/[0.06] bg-slate-950/60 p-3">
            <div class="flex items-center justify-between">
              <h4 class="font-display text-xs font-semibold text-white">
                {education.degree}
              </h4>
              <span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-mono-tech text-emerald-300 border border-emerald-400/30">
                {education.score}
              </span>
            </div>
            <p class="mt-1 text-[11px] text-slate-400">
              {education.institution} · Class of {education.graduationYear}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 4-Step Practice Grid -->
    <div data-reveal class="mt-16 pt-12 border-t border-white/[0.08]">
      <p class="font-mono-tech text-xs font-semibold tracking-wider text-sky-400 uppercase">
        End-to-End Delivery Practice
      </p>
      <h3 class="font-display mt-2 text-2xl font-bold text-white sm:text-3xl">
        From requirements gathering to production release sign-off.
      </h3>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          architecturalPractices.map((step) => (
            <div class="bento-card p-5">
              <span class="font-mono-tech text-xs font-bold text-sky-400">
                {step.number}
              </span>
              <h4 class="font-display mt-2 text-sm font-bold text-white">
                {step.title}
              </h4>
              <p class="mt-2 text-xs leading-relaxed text-slate-400">
                {step.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
