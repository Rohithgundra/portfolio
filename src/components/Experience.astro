---
import { experience } from "../data/site";
---

<section id="experience" class="relative border-t border-white/[0.08] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Header -->
    <div data-reveal class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3 py-1 text-xs font-mono-tech text-sky-300">
        <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
        Career Trajectory
      </div>
      <h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
        <span class="text-gradient-framer">Ten years of engineering leadership,</span> test design to AI architecture.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed">
        Consistent record directing engineering squads of 10 to 20 engineers across enterprise AI systems, quality automation, and scalable cloud platforms.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="mt-14 relative">
      <!-- Illuminated vertical beam -->
      <div class="absolute left-4 sm:left-8 top-4 bottom-8 w-px bg-gradient-to-b from-sky-400 via-sky-500/30 to-white/10 hidden sm:block"></div>

      <div class="space-y-8 sm:space-y-10">
        {
          experience.map((item) => (
            <div data-reveal class="relative sm:pl-16">
              <!-- Timeline node dot -->
              <div class="absolute left-6 -translate-x-1/2 top-7 hidden sm:flex h-5 w-5 items-center justify-center rounded-full border-2 border-slate-900 bg-slate-950">
                <span class={`h-2.5 w-2.5 rounded-full ${item.current ? "bg-emerald-400 animate-pulse shadow-md shadow-emerald-400/50" : "bg-sky-400"}`}></span>
              </div>

              <!-- Experience Bento Card -->
              <div class="bento-card p-6 sm:p-8">
                <!-- Header: Role, Company & Period -->
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <div class="flex flex-wrap items-center gap-2.5">
                      <h3 class="font-display text-xl sm:text-2xl font-bold text-white">
                        {item.title}
                      </h3>
                      {item.current && (
                        <span class="inline-flex items-center rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-xs font-medium text-emerald-300 border border-emerald-500/30">
                          Current Role
                        </span>
                      )}
                      {item.teamSize && (
                        <span class="inline-flex items-center rounded-full bg-sky-500/10 px-2.5 py-0.5 text-xs font-mono-tech text-sky-300 border border-sky-500/20">
                          Led {item.teamSize}
                        </span>
                      )}
                    </div>

                    <div class="mt-1.5 flex flex-wrap items-center gap-2 text-sm">
                      <span class="font-semibold text-sky-400">{item.company}</span>
                      {item.subCompany && (
                        <span class="text-slate-400">({item.subCompany})</span>
                      )}
                      <span class="text-slate-600">•</span>
                      <span class="text-slate-400">{item.location}</span>
                    </div>
                  </div>

                  <div class="rounded-lg border border-white/[0.08] bg-white/[0.03] px-3 py-1.5 font-mono-tech text-xs text-slate-300">
                    {item.when}
                  </div>
                </div>

                <!-- Summary -->
                <p class="mt-4 text-xs sm:text-sm leading-relaxed text-slate-300">
                  {item.summary}
                </p>

                <!-- Bullets -->
                <div class="mt-5 border-t border-white/[0.08] pt-5">
                  <h4 class="font-mono-tech text-xs font-semibold tracking-wider text-slate-400 uppercase">
                    Deliverables & Engineering Execution
                  </h4>
                  <ul class="mt-3 space-y-2 text-xs sm:text-sm text-slate-300">
                    {item.bullets.map((bullet) => (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-1 text-sky-400 shrink-0">
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                          </svg>
                        </span>
                        <span class="leading-relaxed">{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Project Highlight Callout -->
                {item.projectHighlight && (
                  <div class="mt-5 rounded-xl border border-sky-500/25 bg-sky-500/5 px-4 py-3 text-xs sm:text-sm">
                    <span class="font-semibold text-sky-300">Impact Focus ({item.projectHighlight.name}): </span>
                    <span class="text-slate-300">{item.projectHighlight.details}</span>
                  </div>
                )}

                <!-- Tech Tags -->
                <div class="mt-5 flex flex-wrap gap-1.5">
                  {item.tags.map((tag) => (
                    <span class="rounded bg-white/[0.04] px-2.5 py-1 text-xs font-mono-tech text-slate-300 border border-white/[0.06]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
