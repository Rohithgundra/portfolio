---
import { profile } from "../data/site";
---

<section id="contact" class="relative border-t border-white/[0.08] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.1fr]">
      <!-- Direct Channels Bento Column -->
      <div data-reveal class="flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3 py-1 text-xs font-mono-tech text-sky-300">
            <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
            Direct Communications
          </div>
          <h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
            <span class="text-gradient-framer">Let’s discuss</span> enterprise AI architecture or leadership.
          </h2>
          <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed max-w-lg">
            Available for conversations regarding Generative AI technical architecture, multi-agent platform initiatives, and engineering leadership.
          </p>

          <!-- Contact Bento Cards -->
          <div class="mt-8 space-y-3.5 max-w-md">
            <!-- Email Card -->
            <div class="bento-card p-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400 border border-sky-400/20">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-mono-tech text-slate-400 uppercase tracking-wider">Email Address</p>
                  <a href={`mailto:${profile.email}`} class="text-xs sm:text-sm font-semibold text-white hover:text-sky-300 transition-colors">
                    {profile.email}
                  </a>
                </div>
              </div>
              <button
                type="button"
                onclick={`window.copyToClipboard('${profile.email}', 'Copied email: ${profile.email}')`}
                class="rounded-lg border border-white/[0.08] bg-white/[0.03] p-2 text-slate-300 hover:text-white hover:border-white/20 transition-colors"
                title="Copy email to clipboard"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>

            <!-- Phone Card -->
            <div class="bento-card p-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-400/20">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-mono-tech text-slate-400 uppercase tracking-wider">Phone & WhatsApp</p>
                  <a href={`tel:${profile.rawPhone}`} class="text-xs sm:text-sm font-semibold text-white hover:text-emerald-300 transition-colors">
                    {profile.phone}
                  </a>
                </div>
              </div>
              <button
                type="button"
                onclick={`window.copyToClipboard('${profile.phone}', 'Copied phone: ${profile.phone}')`}
                class="rounded-lg border border-white/[0.08] bg-white/[0.03] p-2 text-slate-300 hover:text-white hover:border-white/20 transition-colors"
                title="Copy phone number"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>

            <!-- LinkedIn Card -->
            <div class="bento-card p-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400 border border-blue-400/20">
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-mono-tech text-slate-400 uppercase tracking-wider">Professional Profile</p>
                  <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm font-semibold text-white hover:text-blue-300 transition-colors">
                    {profile.linkedinLabel}
                  </a>
                </div>
              </div>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-white/[0.08] bg-white/[0.03] p-2 text-slate-300 hover:text-white hover:border-white/20 transition-colors"
                title="Open LinkedIn"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <p class="text-xs font-mono-tech text-slate-400 pt-6">
          Base: {profile.location} · Available for Leadership & Advisory
        </p>
      </div>

      <!-- Recruiter Inquiry Bento Form -->
      <div data-reveal data-reveal-delay="150" class="bento-card p-6 sm:p-8">
        <h3 class="font-display text-xl font-bold text-white">
          Recruiter & Hiring Inquiry
        </h3>
        <p class="mt-1 text-xs text-slate-400">
          Select your inquiry topic to generate a structured message directly to Rohith.
        </p>

        <form id="recruiter-contact-form" class="mt-6 space-y-4" novalidate>
          <div>
            <label for="topic" class="block text-xs font-mono-tech text-slate-300 mb-1.5">
              Opportunity / Inquiry Topic
            </label>
            <select
              id="topic"
              name="topic"
              class="w-full rounded-xl border border-white/[0.08] bg-slate-950/80 px-3.5 py-2.5 text-xs sm:text-sm text-white focus:border-sky-400 focus:outline-none"
            >
              <option value="Technical Architect Role">Full-time Technical Architect Opportunity</option>
              <option value="Generative AI Leadership">Generative AI / Multi-Agent Platform Leadership</option>
              <option value="SDET / QA Architecture">Staff SDET / QA Leadership Role</option>
              <option value="Technical Consultation">Technical Advisory / Consultation</option>
              <option value="General Professional Note">General Professional Note</option>
            </select>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-xs font-mono-tech text-slate-300 mb-1.5">
                Your Name / Organization *
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Jane Doe, Tech Recruiting"
                class="w-full rounded-xl border border-white/[0.08] bg-slate-950/80 px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-mono-tech text-slate-300 mb-1.5">
                Your Email *
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="jane@company.com"
                class="w-full rounded-xl border border-white/[0.08] bg-slate-950/80 px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-mono-tech text-slate-300 mb-1.5">
              Message or Role Specifications *
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Provide role details, tech stack expectations, or meeting timing..."
              class="w-full rounded-xl border border-white/[0.08] bg-slate-950/80 px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-500 px-6 py-3 text-xs sm:text-sm font-semibold text-slate-950 transition-all hover:bg-sky-400 active:scale-95 shadow-md shadow-sky-500/20"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Draft Email to Rohith</span>
            </button>

            <span class="text-[11px] text-slate-400 font-mono-tech">
              Recipient: {profile.email}
            </span>
          </div>

          <p id="form-feedback" class="text-xs text-emerald-400 min-h-4" role="status"></p>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <footer class="mt-20 border-t border-white/[0.08] pt-8 pb-12">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row text-xs text-slate-400 font-mono-tech">
        <p>
          © {new Date().getFullYear()} {profile.name} · Technical Architect & GenAI Specialist
        </p>
        <div class="flex items-center gap-4">
          <a href="/resume" class="hover:text-white transition-colors">Resume (PDF)</a>
          <span>•</span>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
          <span>•</span>
          <a href={`mailto:${profile.email}`} class="hover:text-white transition-colors">Email</a>
        </div>
      </div>
    </footer>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#recruiter-contact-form");
  const feedback = document.querySelector<HTMLElement>("#form-feedback");
  const targetEmail = "Rohith.Gundra@Hotmail.com";

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const topic = String(data.get("topic") ?? "").trim();
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const msg = String(data.get("message") ?? "").trim();

    const subject = encodeURIComponent(`[${topic}] Opportunity Note from ${name}`);
    const body = encodeURIComponent(
      `Hi Rohith,\n\n${msg}\n\nSender: ${name}\nEmail: ${email}\nRegarding: ${topic}`
    );

    window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${body}`;

    if (feedback) {
      feedback.textContent = "Opening your email app with this pre-formatted message...";
    }
  });
</script>
