---
import { skillCategories } from "../data/site";
---

<section id="skills" class="relative border-t border-white/[0.08] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Header -->
    <div data-reveal class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3 py-1 text-xs font-mono-tech text-sky-300">
        <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
        Core Competencies & Tech Stack
      </div>
      <h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
        <span class="text-gradient-framer">Architectural toolkit</span> and engineering stacks.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed">
        Disciplined enterprise capabilities applied across 10+ years of high-scale AI systems, quality automation frameworks, and cloud delivery.
      </p>
    </div>

    <!-- Bento Skills Grid -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillCategories.map((cat, idx) => (
          <div
            data-reveal
            class={`bento-card p-6 flex flex-col justify-between ${
              idx === 0 ? "sm:col-span-2 lg:col-span-2" : ""
            }`}
          >
            <div>
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="font-display text-lg sm:text-xl font-bold text-white group-hover:text-sky-300 transition-colors">
                    {cat.title}
                  </h3>
                  <p class="mt-1 text-xs text-slate-400">
                    {cat.subtitle}
                  </p>
                </div>
                <span class="rounded-lg border border-white/[0.08] bg-white/[0.03] p-2 text-sky-400 font-mono-tech text-xs">
                  0{idx + 1}
                </span>
              </div>

              <!-- Skills List -->
              <div class="mt-6 flex flex-wrap gap-2">
                {cat.skills.map((skill) => (
                  <span
                    class={`rounded-lg px-3 py-1.5 text-xs font-mono-tech transition-all ${
                      skill.highlight
                        ? "border border-sky-400/40 bg-sky-500/15 text-sky-200 font-semibold shadow-sm hover:border-sky-400 hover:bg-sky-500/25"
                        : "border border-white/[0.06] bg-white/[0.02] text-slate-300 hover:border-white/20 hover:text-white"
                    }`}
                  >
                    <span class={`mr-1.5 inline-block h-1.5 w-1.5 rounded-full ${skill.highlight ? "bg-sky-400" : "bg-slate-500"}`}></span>
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono-tech text-slate-400">
              <span>Enterprise Verified</span>
              <span class="text-sky-400">10+ YOE Depth</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
